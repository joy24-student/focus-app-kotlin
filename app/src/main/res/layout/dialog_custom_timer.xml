<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_background"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Dialog Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="⚙️ Custom Timer Settings"
                android:textColor="@color/text_main"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnDialogClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/text_muted"
                android:textSize="18sp" />
        </RelativeLayout>

        <!-- Focus Duration -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Deep Focus Duration (minutes)"
            android:textColor="@color/text_main"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCustomFocus"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/input_background"
            android:inputType="number"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="25"
            android:textColor="@color/text_main"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/presetF15"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/chip_background"
                android:text="15m"
                android:textColor="@color/text_main"
                android:textSize="11sp" />

            <Button
                android:id="@+id/presetF25"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/chip_background"
                android:text="25m"
                android:textColor="@color/text_main"
                android:textSize="11sp" />

            <Button
                android:id="@+id/presetF45"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/chip_background"
                android:text="45m"
                android:textColor="@color/text_main"
                android:textSize="11sp" />

            <Button
                android:id="@+id/presetF60"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/chip_background"
                android:text="60m"
                android:textColor="@color/text_main"
                android:textSize="11sp" />

            <Button
                android:id="@+id/presetF90"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/chip_background"
                android:text="90m"
                android:textColor="@color/text_main"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Short Break Duration -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Short Break Duration (minutes)"
            android:textColor="@color/text_main"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCustomShort"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/input_background"
            android:inputType="number"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="5"
            android:textColor="@color/text_main"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/presetS3"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/chip_background"
                android:text="3m"
                android:textColor="@color/text_main"
                android:textSize="11sp" />

            <Button
                android:id="@+id/presetS5"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/chip_background"
                android:text="5m"
                android:textColor="@color/text_main"
                android:textSize="11sp" />

            <Button
                android:id="@+id/presetS10"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/chip_background"
                android:text="10m"
                android:textColor="@color/text_main"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Long Break Duration -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Long Break Duration (minutes)"
            android:textColor="@color/text_main"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCustomLong"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/input_background"
            android:inputType="number"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="15"
            android:textColor="@color/text_main"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/presetL15"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/chip_background"
                android:text="15m"
                android:textColor="@color/text_main"
                android:textSize="11sp" />

            <Button
                android:id="@+id/presetL20"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/chip_background"
                android:text="20m"
                android:textColor="@color/text_main"
                android:textSize="11sp" />

            <Button
                android:id="@+id/presetL30"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/chip_background"
                android:text="30m"
                android:textColor="@color/text_main"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Dialog Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnResetDefaults"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/btn_secondary"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Defaults"
                android:textColor="@color/text_main"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSaveCustomTimer"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/btn_primary"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Save &amp; Apply"
                android:textColor="@color/bg_dark"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
